<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Law Firm Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
    <script>
        // Initialize theme before page renders to prevent flash
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark' || (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-bs-theme', 'dark');
                document.documentElement.classList.add('dark-mode');
            }
        })();
    </script>
    @RenderSection("Styles", required: false)
</head>
<body class="@(ViewBag.Theme == "dark" ? "dark-mode" : "")">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Hamburger Toggle Button -->
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle navigation">
        <span class="hamburger"></span>
    </button>
    
    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    
    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <nav class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
            <div class="sidebar-header">
                <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                    <img src="/images/document_logo.png" alt="Logo" style="width: 32px; height: 32px; object-fit: contain;" />
                    <span id="sidebarFirmName">Law Firm DMS</span>
                </a>
            </div>
            
            <div class="sidebar-nav">
                <div class="nav-section">
                    <div class="nav-section-title" id="nav-main">Main</div>
                    <ul class="nav flex-column" role="menu" aria-labelledby="nav-main">
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index" role="menuitem">
                                <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Document" asp-action="Index" role="menuitem">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                <span>Documents</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Folder" asp-action="Index" role="menuitem">
                                <i class="bi bi-folder" aria-hidden="true"></i>
                                <span>Folders</span>
                            </a>
                        </li>
                    </ul>
                </div>
                
                <div class="nav-section">
                    <div class="nav-section-title" id="nav-mgmt">Management</div>
                    <ul class="nav flex-column" role="menu" aria-labelledby="nav-mgmt">
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="User" asp-action="Index" role="menuitem">
                                <i class="bi bi-people" aria-hidden="true"></i>
                                <span>Users</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Role" asp-action="Index" role="menuitem">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                <span>Roles</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Review" asp-action="Index" role="menuitem">
                                <i class="bi bi-check2-square" aria-hidden="true"></i>
                                <span>Reviews</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Review" asp-action="Completed" role="menuitem">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>
                                <span>Review History</span>
                            </a>
                        </li>
                    </ul>
                </div>
                
                <div class="nav-section">
                    <div class="nav-section-title" id="nav-system">System</div>
                    <ul class="nav flex-column" role="menu" aria-labelledby="nav-system">
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Billing" asp-action="Index" role="menuitem">
                                <i class="bi bi-credit-card" aria-hidden="true"></i>
                                <span>Billing & Payments</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Retention" asp-action="Index" role="menuitem">
                                <i class="bi bi-clock-history" aria-hidden="true"></i>
                                <span>Retention</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Retention" asp-action="DestructionCertificates" role="menuitem">
                                <i class="bi bi-file-earmark-lock" aria-hidden="true"></i>
                                <span>Destruction Certs</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Archive" asp-action="Index" role="menuitem">
                                <i class="bi bi-archive" aria-hidden="true"></i>
                                <span>Archive</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Audit" asp-action="Index" role="menuitem">
                                <i class="bi bi-list-check" aria-hidden="true"></i>
                                <span>Audit Logs</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Report" asp-action="Index" role="menuitem">
                                <i class="bi bi-bar-chart" aria-hidden="true"></i>
                                <span>Reports</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Settings" asp-action="Index" role="menuitem">
                                <i class="bi bi-gear" aria-hidden="true"></i>
                                <span>Settings</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="Chat" asp-action="Index" role="menuitem">
                                <i class="bi bi-chat-dots" aria-hidden="true"></i>
                                <span>Live Chat</span>
                                <span class="badge bg-danger rounded-pill ms-auto d-none" id="chatNavBadge">0</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="sidebar-user">
                <div class="user-info">
                    <div class="user-avatar" aria-hidden="true">
                        <i class="bi bi-person"></i>
                    </div>
                    <div class="user-details">
                        <div class="user-name">@User.Identity?.Name</div>
                        <div class="user-role">Administrator</div>
                    </div>
                </div>
            </div>
        </nav>
        
        <!-- Main Content -->
        <main class="main-content" id="main-content" role="main">
            <header class="header">
                <h1 class="header-title">@ViewData["Title"]</h1>
                <div class="header-actions">
                    <!-- Notification Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-secondary position-relative" type="button" id="notificationDropdown" 
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notificationBadge">
                                0
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown" style="width: 350px; max-height: 400px; overflow-y: auto;">
                            <div class="dropdown-header d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Notifications</span>
                                <button class="btn btn-sm btn-link text-decoration-none p-0" onclick="markAllAsRead()">Mark all as read</button>
                            </div>
                            <div class="dropdown-divider"></div>
                            <div id="notificationList">
                                <div class="text-center text-muted p-3">
                                    <i class="bi bi-bell-slash fs-4"></i>
                                    <p class="mb-0 small">No notifications</p>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-center text-primary" asp-controller="Notification" asp-action="Index">
                                View all notifications
                            </a>
                        </div>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-secondary">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </header>
            
            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script>
        // Chat badge for sidebar (Admin only)
        document.addEventListener('DOMContentLoaded', function() {
            loadChatBadge();
            setInterval(loadChatBadge, 15000);
        });

        async function loadChatBadge() {
            try {
                const response = await fetch('/api/ChatApi/waiting-count');
                if (response.ok) {
                    const data = await response.json();
                    const badge = document.getElementById('chatNavBadge');
                    if (badge) {
                        if (data.count > 0) {
                            badge.textContent = data.count;
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }
                }
            } catch (error) {
                // Chat badge load error - non-critical
            }
        }

        // Sidebar Toggle Functionality
        (function() {
            const toggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const mainContent = document.querySelector('.main-content');
            
            if (toggle && sidebar) {
                // Load saved sidebar state from localStorage
                const savedState = localStorage.getItem('sidebarCollapsed');
                if (savedState === 'true' && window.innerWidth > 991) {
                    sidebar.classList.add('collapsed');
                    if (mainContent) mainContent.classList.add('expanded');
                    toggle.classList.add('active');
                }
                
                toggle.addEventListener('click', function() {
                    if (window.innerWidth > 991) {
                        // Desktop: collapse/expand sidebar
                        sidebar.classList.toggle('collapsed');
                        if (mainContent) mainContent.classList.toggle('expanded');
                        toggle.classList.toggle('active');
                        // Save state to localStorage
                        localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
                    } else {
                        // Mobile: slide in/out with overlay
                        toggle.classList.toggle('active');
                        sidebar.classList.toggle('active');
                        if (overlay) overlay.classList.toggle('active');
                        document.body.style.overflow = sidebar.classList.contains('active') ? 'hidden' : '';
                    }
                });
                
                if (overlay) {
                    overlay.addEventListener('click', function() {
                        toggle.classList.remove('active');
                        sidebar.classList.remove('active');
                        overlay.classList.remove('active');
                        document.body.style.overflow = '';
                    });
                }
                
                // Close sidebar on nav link click (mobile)
                sidebar.querySelectorAll('.nav-link').forEach(link => {
                    link.addEventListener('click', function() {
                        if (window.innerWidth <= 991) {
                            toggle.classList.remove('active');
                            sidebar.classList.remove('active');
                            if (overlay) overlay.classList.remove('active');
                            document.body.style.overflow = '';
                        }
                    });
                });
                
                // Handle window resize
                window.addEventListener('resize', function() {
                    if (window.innerWidth > 991) {
                        // Remove mobile classes when resizing to desktop
                        sidebar.classList.remove('active');
                        if (overlay) overlay.classList.remove('active');
                        document.body.style.overflow = '';
                        // Re-apply desktop collapsed state from localStorage
                        const savedState = localStorage.getItem('sidebarCollapsed');
                        if (savedState === 'true') {
                            sidebar.classList.add('collapsed');
                            if (mainContent) mainContent.classList.add('expanded');
                            toggle.classList.add('active');
                        }
                    } else {
                        // Remove desktop classes when resizing to mobile
                        sidebar.classList.remove('collapsed');
                        if (mainContent) mainContent.classList.remove('expanded');
                        toggle.classList.remove('active');
                    }
                });
            }
        })();

        // Apply dark mode from localStorage on page load
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark' || (theme === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.body.classList.add('dark-mode');
            }
        })();
    </script>
    
    <script>
        // Load firm name for sidebar
        (function() {
            fetch('/api/SettingsApi/firm-name')
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.firmName) {
                        const el = document.getElementById('sidebarFirmName');
                        if (el) el.textContent = data.firmName;
                    }
                })
                .catch(() => {});
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
