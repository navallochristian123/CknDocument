@using CKNDocument.Models.DTOs
@model ForgotPasswordResetDto
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
    var maskedEmail = ViewData["MaskedEmail"]?.ToString() ?? "your account";
}

@await Html.PartialAsync("_Toast")

<div class="text-center mb-4">
    <h2 style="font-weight:700; margin-bottom:8px;">Set New Password</h2>
    <p style="color:#6b7280; margin-bottom:0;">Create a new password for <strong>@maskedEmail</strong>.</p>
</div>

<form method="post" asp-controller="Auth" asp-action="ResetPassword" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
    
    <div class="form-group">
        <label class="form-label" asp-for="NewPassword"></label>
        <input asp-for="NewPassword"
               type="password"
               class="form-input"
               placeholder="Enter new password"
               autocomplete="new-password"
               required />
        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
    </div>
    
    <div class="form-group">
        <label class="form-label" asp-for="ConfirmNewPassword"></label>
        <input asp-for="ConfirmNewPassword"
               type="password"
               class="form-input"
               placeholder="Confirm new password"
               autocomplete="new-password"
               required />
        <span asp-validation-for="ConfirmNewPassword" class="field-validation-error"></span>
    </div>
    
    <button type="submit" class="btn-primary" style="width:100%;">
        Reset Password
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
