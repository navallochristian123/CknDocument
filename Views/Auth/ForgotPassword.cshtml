@using CKNDocument.Models.DTOs
@model ForgotPasswordRequestDto
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

@await Html.PartialAsync("_Toast")

<form method="post" asp-controller="Auth" asp-action="ForgotPassword" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    
    <p class="text-muted text-center mb-4">
        Enter the email address used when your account was created. We will send a one-time verification code.
    </p>
    
    <div class="mb-3">
        <label class="form-label" asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="Enter your registered email" required autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary w-100 mb-3">
        <i class="bi bi-envelope"></i> Send OTP Code
    </button>
    
    <div class="text-center">
        <a asp-controller="Auth" asp-action="Login" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Login
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
