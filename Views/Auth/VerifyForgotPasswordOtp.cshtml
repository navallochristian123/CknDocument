@{
    ViewData["Title"] = "Verify Reset Code";
    Layout = "_AuthLayout";
    var maskedEmail = ViewData["MaskedEmail"]?.ToString() ?? "your email";
}

@await Html.PartialAsync("_Toast")

<div class="text-center mb-4">
    <h2 style="font-weight:700; margin-bottom:8px;">Password Reset Verification</h2>
    <p style="color:#6b7280; margin-bottom:0;">Enter the 6-digit code sent to <strong>@maskedEmail</strong>.</p>
</div>

<form method="post" asp-controller="Auth" asp-action="VerifyForgotPasswordOtp" novalidate>
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label class="form-label" for="otpCode">Verification Code</label>
        <input type="text"
               class="form-input"
               id="otpCode"
               name="otpCode"
               maxlength="6"
               minlength="6"
               inputmode="numeric"
               autocomplete="one-time-code"
               placeholder="Enter 6-digit code"
               required />
    </div>

    <button type="submit" class="btn-primary" style="width:100%; margin-top:6px;">Verify Code</button>
</form>

<form method="post" asp-controller="Auth" asp-action="ResendForgotPasswordOtp" style="margin-top:12px;">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn-outline" style="width:100%;">Resend Code</button>
</form>

<div style="margin-top:16px; text-align:center; color:#6b7280; font-size:14px;">
    If the email is no longer accessible, contact your administrator.
</div>
