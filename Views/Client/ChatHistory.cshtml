@{
    ViewData["Title"] = "Chat History";
    Layout = "_ClientLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-chat-dots me-2"></i>My Support Chats</h4>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="chatHistoryTable">
                    <thead>
                        <tr class="border-bottom">
                            <th class="py-3 px-4">Date</th>
                            <th class="py-3">Subject</th>
                            <th class="py-3">Category</th>
                            <th class="py-3">Status</th>
                            <th class="py-3">Admin</th>
                        </tr>
                    </thead>
                    <tbody id="chatHistoryBody">
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-chat-square-text" style="font-size: 32px; opacity: 0.3;"></i>
                                <p class="mt-2 mb-0">No chat history found. Use the chat bubble to start a conversation.</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            fetch('/api/ChatApi/conversations')
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.data.length > 0) {
                        const tbody = document.getElementById('chatHistoryBody');
                        tbody.innerHTML = data.data.map(c => {
                            const statusClass = c.status === 'Closed' ? 'bg-secondary'
                                : c.status === 'WithAdmin' ? 'bg-success'
                                : c.status === 'WaitingForAdmin' ? 'bg-warning text-dark'
                                : 'bg-info';
                            const date = c.createdAt ? new Date(c.createdAt).toLocaleDateString() : '-';
                            return `<tr>
                                <td class="py-3 px-4">${date}</td>
                                <td class="py-3">${c.subject || '-'}</td>
                                <td class="py-3">${c.category || '-'}</td>
                                <td class="py-3"><span class="badge ${statusClass}">${c.status}</span></td>
                                <td class="py-3">${c.adminName || 'Chatbot'}</td>
                            </tr>`;
                        }).join('');
                    }
                })
                .catch(console.error);
        });
    </script>
}
