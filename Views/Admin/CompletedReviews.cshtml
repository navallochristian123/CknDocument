@{
    ViewData["Title"] = "My Completed Reviews";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0"><i class="bi bi-check2-all me-2 text-success"></i>My Completed Reviews</h4>
        <p class="text-muted mb-0" id="pageSubtitle">Documents you have approved or rejected</p>
    </div>
    <button class="btn btn-outline-secondary" onclick="loadCompleted()">
        <i class="bi bi-arrow-clockwise me-1"></i> Refresh
    </button>
</div>

<!-- Stats -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-success bg-opacity-10 p-3 me-3">
                    <i class="bi bi-check-circle-fill text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Approved</div>
                    <div class="fw-bold fs-4" id="approvedCount">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-danger bg-opacity-10 p-3 me-3">
                    <i class="bi bi-x-circle-fill text-danger fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Rejected</div>
                    <div class="fw-bold fs-4" id="rejectedCount">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                    <i class="bi bi-journal-check text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Reviewed</div>
                    <div class="fw-bold fs-4" id="totalCount">0</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-3 bg-info bg-opacity-10 p-3 me-3">
                    <i class="bi bi-calendar-check text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Last Review</div>
                    <div class="fw-bold" id="latestDate">-</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" id="searchTerm" class="form-control"
                       placeholder="Search by document title or client..."
                       onkeypress="if(event.key==='Enter')filterResults()">
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select id="filterStatus" class="form-select" onchange="filterResults()">
                    <option value="">All Statuses</option>
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Show</label>
                <select id="showCount" class="form-select" onchange="loadCompleted()">
                    <option value="20">Last 20</option>
                    <option value="50">Last 50</option>
                    <option value="100">Last 100</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" onclick="filterResults()">
                    <i class="bi bi-search me-1"></i> Filter
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center py-3">
        <strong><i class="bi bi-list-check me-2 text-primary"></i>Review History</strong>
        <span class="badge bg-primary rounded-pill" id="resultCount">0</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Document</th>
                        <th>Client</th>
                        <th>Reviewed Date</th>
                        <th>Status</th>
                        <th>Checklist</th>
                        <th>Remarks</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody id="completedTable">
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="text-muted mt-2">Loading review history...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Document Preview Modal -->
<div class="modal fade" id="reviewPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-fullscreen-lg-down">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-eye me-2"></i><span id="reviewPreviewTitle">Document Preview</span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="height:78vh; overflow:auto;">
                <div class="text-center py-5" id="reviewPreviewLoading">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">Loading preview...</p>
                </div>
                <iframe id="reviewPreviewIframe" class="w-100 h-100 border-0" style="display:none;"></iframe>
                <div id="reviewPreviewImageWrap" class="text-center p-4" style="display:none;">
                    <img id="reviewPreviewImg" style="max-width:100%; max-height:72vh;" />
                </div>
                <div id="reviewPreviewText" class="p-4" style="display:none; font-family:'Segoe UI',sans-serif; line-height:1.7;"></div>
            </div>
            <div class="modal-footer">
                <a href="#" id="reviewPreviewDownloadBtn" class="btn btn-outline-secondary">
                    <i class="bi bi-download me-1"></i>Download
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Review Detail Modal -->
<div class="modal fade" id="reviewDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Review Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="reviewDetailBody">
                Loading...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let allCompleted = [];

    document.addEventListener('DOMContentLoaded', loadCompleted);

    async function loadCompleted() {
        const take = document.getElementById('showCount').value;
        try {
            const response = await fetch(`/api/DashboardApi/admin-completed?take=${take}`);
            if (!response.ok) throw new Error('Failed – ' + response.status);
            const ct = response.headers.get('content-type') || '';
            if (!ct.includes('application/json')) throw new Error('Non-JSON response');
            const data = await response.json();
            if (data.success) {
                allCompleted = data.completed || [];
                updateStats();
                filterResults();
            } else {
                throw new Error(data.message || 'Unknown error');
            }
        } catch (e) {
            console.error('Error loading completed reviews:', e);
            document.getElementById('completedTable').innerHTML =
                `<tr><td colspan="7" class="text-center text-danger py-4">
                    <i class="bi bi-exclamation-circle fs-3 d-block mb-2"></i>
                    Error loading completed reviews: ${e.message}. Please refresh.
                 </td></tr>`;
        }
    }

    function updateStats() {
        const approved = allCompleted.filter(c => c.reviewStatus === 'Approved').length;
        const rejected = allCompleted.filter(c => c.reviewStatus === 'Rejected').length;
        document.getElementById('approvedCount').textContent = approved;
        document.getElementById('rejectedCount').textContent = rejected;
        document.getElementById('totalCount').textContent = allCompleted.length;
        document.getElementById('pageSubtitle').textContent = `Documents you have reviewed \u2013 ${allCompleted.length} record(s)`;
        if (allCompleted.length > 0 && allCompleted[0].reviewedAt) {
            document.getElementById('latestDate').textContent =
                new Date(allCompleted[0].reviewedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }
    }

    function filterResults() {
        const search = document.getElementById('searchTerm').value.toLowerCase();
        const status = document.getElementById('filterStatus').value;
        let filtered = allCompleted;
        if (search) {
            filtered = filtered.filter(c =>
                (c.documentTitle || '').toLowerCase().includes(search) ||
                (c.clientName || '').toLowerCase().includes(search) ||
                (c.originalFileName || '').toLowerCase().includes(search));
        }
        if (status) filtered = filtered.filter(c => c.reviewStatus === status);
        document.getElementById('resultCount').textContent = filtered.length;
        renderTable(filtered);
    }

    function renderTable(items) {
        const tbody = document.getElementById('completedTable');
        if (!items || items.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5">
                <i class="bi bi-check2-circle fs-1 text-muted d-block mb-2"></i>
                <p class="text-muted">No completed reviews found</p></td></tr>`;
            return;
        }
        tbody.innerHTML = items.map(c => {
            const isApproved = c.reviewStatus === 'Approved';
            const badgeClass = isApproved ? 'success' : 'danger';
            const icon = isApproved ? 'bi-check-circle' : 'bi-x-circle';
            const statusLabel = isApproved ? 'Approved' : 'Rejected';
            const scoreHtml = c.checklistScore != null
                ? `<span class="badge bg-${c.checklistScore >= 70 ? 'success' : c.checklistScore >= 40 ? 'warning' : 'danger'} bg-opacity-75">
                    ${c.checklistScore}% ${c.isChecklistComplete ? '<i class="bi bi-check2"></i>' : ''}
                   </span>`
                : '<span class="text-muted small">-</span>';

            return `<tr>
                <td class="ps-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-text text-primary me-2 fs-5"></i>
                        <div>
                            <div class="fw-medium">${escapeHtml(c.documentTitle || c.originalFileName || 'Untitled')}</div>
                            <small class="text-muted">${escapeHtml(c.originalFileName || '')}</small>
                        </div>
                    </div>
                </td>
                <td>${escapeHtml(c.clientName || '-')}</td>
                <td><small class="text-muted">${formatDate(c.reviewedAt)}</small></td>
                <td><span class="badge bg-${badgeClass}"><i class="bi ${icon} me-1"></i>${statusLabel}</span></td>
                <td>${scoreHtml}</td>
                <td class="text-truncate" style="max-width:180px;" title="${escapeHtml(c.remarks || '')}">
                    <small>${escapeHtml(c.remarks || '-')}</small>
                </td>
                <td class="text-end pe-4">
                    <button class="btn btn-sm btn-outline-primary me-1"
                        onclick="previewDoc(${c.documentId}, '${escapeHtml(c.documentTitle || 'Document')}')"
                        title="Preview">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary"
                        onclick="showDetail(${c.reviewId})"
                        title="Details">
                        <i class="bi bi-info-circle"></i>
                    </button>
                </td>
            </tr>`;
        }).join('');
    }

    async function previewDoc(docId, title) {
        document.getElementById('reviewPreviewTitle').textContent = title;
        ['reviewPreviewLoading','reviewPreviewIframe','reviewPreviewImageWrap','reviewPreviewText']
            .forEach(id => document.getElementById(id).style.display = id === 'reviewPreviewLoading' ? 'block' : 'none');
        document.getElementById('reviewPreviewDownloadBtn').href = `/api/DocumentApi/${docId}/download`;
        new bootstrap.Modal(document.getElementById('reviewPreviewModal')).show();
        try {
            const res = await fetch(`/api/DocumentApi/${docId}`);
            const data = await res.json();
            const ext = (data.document?.fileExtension || '').toLowerCase();
            if (ext === '.pdf') {
                const iframe = document.getElementById('reviewPreviewIframe');
                iframe.src = `/api/DocumentApi/${docId}/view`;
                iframe.onload = () => { document.getElementById('reviewPreviewLoading').style.display='none'; iframe.style.display='block'; };
            } else if (['.jpg','.jpeg','.png','.gif'].includes(ext)) {
                const img = document.getElementById('reviewPreviewImg');
                img.src = `/api/DocumentApi/${docId}/view`;
                img.onload = () => { document.getElementById('reviewPreviewLoading').style.display='none'; document.getElementById('reviewPreviewImageWrap').style.display='block'; };
            } else {
                const r2 = await fetch(`/api/DocumentApi/${docId}/text-content`);
                const d2 = await r2.json();
                const el = document.getElementById('reviewPreviewText');
                document.getElementById('reviewPreviewLoading').style.display = 'none';
                el.style.display = 'block';
                el.innerHTML = d2.success && d2.content
                    ? d2.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').split('\n').filter(l=>l.trim()).map(l=>`<p class="mb-2">${l}</p>`).join('')
                    : `<div class="text-center py-5"><i class="bi bi-file-earmark-x display-1 text-muted"></i><p class="mt-3 text-muted">Preview not available.</p><a href="/api/DocumentApi/${docId}/download" class="btn btn-primary mt-2"><i class="bi bi-download me-1"></i>Download</a></div>`;
            }
        } catch { document.getElementById('reviewPreviewLoading').style.display='none'; document.getElementById('reviewPreviewText').innerHTML='<p class="text-danger text-center p-4">Error loading preview.</p>'; document.getElementById('reviewPreviewText').style.display='block'; }
    }

    function showDetail(reviewId) {
        const review = allCompleted.find(c => c.reviewId === reviewId);
        if (!review) return;
        const isApproved = review.reviewStatus === 'Approved';
        document.getElementById('reviewDetailBody').innerHTML = `
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted small">Document</label>
                    <p class="mb-0 fw-medium">${escapeHtml(review.documentTitle || '-')}</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Client</label>
                    <p class="mb-0">${escapeHtml(review.clientName || '-')}</p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Decision</label>
                    <p class="mb-0"><span class="badge bg-${isApproved?'success':'danger'}">${review.reviewStatus}</span></p>
                </div>
                <div class="col-md-6">
                    <label class="text-muted small">Reviewed At</label>
                    <p class="mb-0">${formatDate(review.reviewedAt)}</p>
                </div>
                ${review.checklistScore != null ? `
                <div class="col-md-6">
                    <label class="text-muted small">Checklist Score</label>
                    <p class="mb-0">${review.checklistScore}% ${review.isChecklistComplete ? '(Complete)' : '(Incomplete)'}</p>
                </div>` : ''}
                <div class="col-12">
                    <label class="text-muted small">Remarks</label>
                    <p class="mb-0 bg-light p-3 rounded">${escapeHtml(review.remarks || 'No remarks provided.')}</p>
                </div>
                ${review.internalNotes ? `
                <div class="col-12">
                    <label class="text-muted small">Internal Notes</label>
                    <p class="mb-0 bg-warning bg-opacity-10 p-3 rounded">${escapeHtml(review.internalNotes)}</p>
                </div>` : ''}
            </div>`;
        new bootstrap.Modal(document.getElementById('reviewDetailModal')).show();
    }

    function formatDate(s) {
        if (!s) return '-';
        return new Date(s).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' });
    }
    function escapeHtml(t) {
        if (!t) return '';
        const d = document.createElement('div'); d.textContent = t; return d.innerHTML;
    }
</script>
}
