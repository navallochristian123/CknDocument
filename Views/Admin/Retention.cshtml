@{
    ViewData["Title"] = "Retention Management";
    Layout = "_AdminLayout";
}

@section Styles {
<style>
    .stat-icon-circle {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .status-badge {
        padding: 0.35em 0.75em;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .status-badge.active { background: #d4edda; color: #155724; }
    .status-badge.expiring { background: #fff3cd; color: #856404; }
    .status-badge.expired { background: #f8d7da; color: #721c24; }
</style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">Retention Management</h4>
        <p class="text-muted mb-0 small">Manage document retention policies and track document lifecycles</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPolicyModal">
        <i class="bi bi-plus-circle"></i> Create Policy
    </button>
</div>

<!-- Stats Cards - Clean White Design -->
<div class="row mb-4 g-3">
    <div class="col-md-3">
        <div class="card border">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Total Policies</p>
                        <h3 class="mb-0 fw-bold" id="totalPolicies">-</h3>
                    </div>
                    <div class="stat-icon-circle bg-primary-subtle">
                        <i class="bi bi-file-ruled text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Under Retention</p>
                        <h3 class="mb-0 fw-bold" id="totalRetention">-</h3>
                    </div>
                    <div class="stat-icon-circle bg-success-subtle">
                        <i class="bi bi-clock-history text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Expiring This Month</p>
                        <h3 class="mb-0 fw-bold" id="expiringMonth">-</h3>
                    </div>
                    <div class="stat-icon-circle bg-warning-subtle">
                        <i class="bi bi-exclamation-triangle text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small">Expired</p>
                        <h3 class="mb-0 fw-bold" id="expiredCount">-</h3>
                    </div>
                    <div class="stat-icon-circle bg-danger-subtle">
                        <i class="bi bi-archive text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Retention Tabs -->
<ul class="nav nav-tabs mb-4" id="retentionTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="years-tab" data-bs-toggle="tab" data-bs-target="#yearsTab" type="button" role="tab">
            <i class="bi bi-calendar3 me-1"></i> Years to Retention
            <span class="badge bg-success" id="yearsCount">0</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="months-tab" data-bs-toggle="tab" data-bs-target="#monthsTab" type="button" role="tab">
            <i class="bi bi-calendar-month me-1"></i> Months to Retention
            <span class="badge bg-warning text-dark" id="monthsCount">0</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="days-tab" data-bs-toggle="tab" data-bs-target="#daysTab" type="button" role="tab">
            <i class="bi bi-calendar-day me-1"></i> Days Remaining
            <span class="badge bg-danger" id="daysCount">0</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="policies-tab" data-bs-toggle="tab" data-bs-target="#policiesTab" type="button" role="tab">
            <i class="bi bi-file-ruled me-1"></i> Policies
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="disposition-tab" data-bs-toggle="tab" data-bs-target="#dispositionTab" type="button" role="tab">
            <i class="bi bi-shield-exclamation me-1"></i> Disposition Queue
            <span class="badge bg-dark" id="dispositionCount">0</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="retentionTabContent">
    <!-- Years Tab -->
    <div class="tab-pane fade show active" id="yearsTab" role="tabpanel">
        <div class="card border">
            <div class="card-header bg-white border-bottom">
                <i class="bi bi-calendar3 me-2 text-success"></i>Documents with More Than 1 Year Retention Remaining
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Document</th>
                                <th>Type</th>
                                <th>Client</th>
                                <th>Start Date</th>
                                <th>Expiry Date</th>
                                <th>Time Remaining</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="yearsTableBody">
                            <tr><td colspan="7" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Months Tab -->
    <div class="tab-pane fade" id="monthsTab" role="tabpanel">
        <div class="card border">
            <div class="card-header bg-white border-bottom">
                <i class="bi bi-calendar-month me-2 text-warning"></i>Documents with 1-12 Months Retention Remaining
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Document</th>
                                <th>Type</th>
                                <th>Client</th>
                                <th>Start Date</th>
                                <th>Expiry Date</th>
                                <th>Time Remaining</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="monthsTableBody">
                            <tr><td colspan="7" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Days Tab -->
    <div class="tab-pane fade" id="daysTab" role="tabpanel">
        <div class="alert alert-light border-danger border-start border-4">
            <i class="bi bi-exclamation-triangle me-2 text-danger"></i>
            <strong>Attention Required!</strong> These documents have less than 365 days remaining before automatic archival.
        </div>
        <div class="card border">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-day me-2 text-danger"></i>Documents with Less Than 365 Days Remaining</span>
                <button class="btn btn-sm btn-outline-danger" onclick="processExpired()">
                    <i class="bi bi-archive me-1"></i>Process Expired
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Document</th>
                                <th>Type</th>
                                <th>Client</th>
                                <th>Start Date</th>
                                <th>Expiry Date</th>
                                <th>Days Left</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="daysTableBody">
                            <tr><td colspan="7" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Policies Tab -->
    <div class="tab-pane fade" id="policiesTab" role="tabpanel">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-ruled me-2"></i>Retention Policies</span>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createPolicyModal">
                    <i class="bi bi-plus me-1"></i>Add Policy
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Policy Name</th>
                                <th>Document Type</th>
                                <th>Retention Period</th>
                                <th>Documents</th>
                                <th>Default</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="policiesTableBody">
                            <tr><td colspan="6" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Disposition Queue Tab -->
    <div class="tab-pane fade" id="dispositionTab" role="tabpanel">
        <!-- Disposition Stats -->
        <div class="row mb-3 g-3">
            <div class="col-md-3">
                <div class="card border-start border-warning border-3">
                    <div class="card-body py-2">
                        <small class="text-muted">Pending Review</small>
                        <h4 class="mb-0 fw-bold" id="dispPending">0</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-start border-danger border-3">
                    <div class="card-body py-2">
                        <small class="text-muted">On Hold</small>
                        <h4 class="mb-0 fw-bold" id="dispOnHold">0</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-start border-secondary border-3">
                    <div class="card-body py-2">
                        <small class="text-muted">Destroyed</small>
                        <h4 class="mb-0 fw-bold" id="dispDestroyed">0</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-start border-info border-3">
                    <div class="card-body py-2">
                        <small class="text-muted">Grace Expiring &lt;7d</small>
                        <h4 class="mb-0 fw-bold" id="dispExpiring">0</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Workflow Diagram -->
        <div class="alert alert-light border mb-3">
            <div class="d-flex align-items-center justify-content-center flex-wrap gap-2" style="font-size: 0.85rem;">
                <span class="badge bg-warning text-dark px-3 py-2"><i class="bi bi-clock me-1"></i>Retention Ends</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-primary px-3 py-2"><i class="bi bi-shield-check me-1"></i>Admin Hold Check</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-info text-dark px-3 py-2"><i class="bi bi-check2-circle me-1"></i>30-Day Grace</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-danger px-3 py-2"><i class="bi bi-trash me-1"></i>Delete</span>
                <i class="bi bi-arrow-right text-muted"></i>
                <span class="badge bg-dark px-3 py-2"><i class="bi bi-file-earmark-lock me-1"></i>Audit & Certificate</span>
            </div>
        </div>

        <div class="card border">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-exclamation me-2"></i>Post-Retention Disposition Queue</span>
                <div>
                    <button class="btn btn-sm btn-primary me-2" onclick="processRetentionNow()" id="btnProcessNow">
                        <i class="bi bi-lightning-charge me-1"></i>Process Retention Now
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="loadDispositionQueue()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Document</th>
                                <th>Client</th>
                                <th>Retention Expired</th>
                                <th>Grace Period Ends</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="dispositionTableBody">
                            <tr><td colspan="6" class="text-center py-4 text-muted">Click tab to load disposition queue</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Legal Hold Modal -->
<div class="modal fade" id="holdModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="bi bi-shield-lock me-2"></i>Place Legal Hold</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Placing a legal hold will prevent this document from being auto-deleted even after the grace period ends.
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Document</label>
                    <p id="holdDocTitle" class="mb-0"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Reason for Legal Hold <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="holdReason" rows="3" placeholder="Enter reason for placing legal hold (e.g., ongoing litigation, regulatory inquiry)..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="confirmPlaceHold()">
                    <i class="bi bi-shield-lock me-1"></i>Place Hold
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="createPolicyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="policyModalTitle">Create Retention Policy</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="policyForm">
                    <input type="hidden" id="policyId" value="">
                    <div class="mb-3">
                        <label class="form-label">Policy Name</label>
                        <input type="text" class="form-control" id="policyName" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Document Type</label>
                        <select class="form-select" id="policyDocType">
                            <option value="">All Types</option>
                            <option value="Contract">Contract</option>
                            <option value="Agreement">Agreement</option>
                            <option value="Legal Brief">Legal Brief</option>
                            <option value="Affidavit">Affidavit</option>
                            <option value="Invoice">Invoice</option>
                            <option value="Receipt">Receipt</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-4 mb-3">
                            <label class="form-label">Years</label>
                            <input type="number" class="form-control" id="policyYears" min="0" value="7">
                        </div>
                        <div class="col-4 mb-3">
                            <label class="form-label">Months</label>
                            <input type="number" class="form-control" id="policyMonths" min="0" max="11" value="0">
                        </div>
                        <div class="col-4 mb-3">
                            <label class="form-label">Days</label>
                            <input type="number" class="form-control" id="policyDays" min="0" max="30" value="0">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="policyDescription" rows="2"></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="policyIsDefault">
                        <label class="form-check-label" for="policyIsDefault">
                            Set as default for this document type
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePolicy()">Save Policy</button>
            </div>
        </div>
    </div>
</div>

<!-- Modify Retention Modal -->
<div class="modal fade" id="modifyRetentionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Modify Retention Period</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="modifyRetentionForm">
                    <input type="hidden" id="modifyDocId" value="">
                    <div class="alert alert-info">
                        <strong>Document:</strong> <span id="modifyDocTitle">-</span>
                    </div>
                    <div class="row">
                        <div class="col-4 mb-3">
                            <label class="form-label">Years</label>
                            <input type="number" class="form-control" id="modifyYears" min="0">
                        </div>
                        <div class="col-4 mb-3">
                            <label class="form-label">Months</label>
                            <input type="number" class="form-control" id="modifyMonths" min="0" max="11">
                        </div>
                        <div class="col-4 mb-3">
                            <label class="form-label">Days</label>
                            <input type="number" class="form-control" id="modifyDays" min="0" max="30">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason for Modification</label>
                        <textarea class="form-control" id="modifyReason" rows="2" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveModifiedRetention()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let yearsData = [], monthsData = [], daysData = [], policiesData = [];
    let dispositionData = [];
    let currentHoldArchiveId = null;

    document.addEventListener('DOMContentLoaded', function() {
        loadStats();
        loadRetentionDocuments();
        loadPolicies();
        
        // Load disposition when tab is clicked
        document.getElementById('disposition-tab').addEventListener('shown.bs.tab', function() {
            loadDispositionQueue();
        });
    });

    async function loadStats() {
        try {
            const response = await fetch('/api/RetentionApi/stats');
            if (response.ok) {
                const data = await response.json();
                if (data.success) {
                    document.getElementById('totalPolicies').textContent = data.stats.totalPolicies;
                    document.getElementById('totalRetention').textContent = data.stats.totalDocumentsUnderRetention;
                    document.getElementById('expiringMonth').textContent = data.stats.expiringThisMonth;
                    document.getElementById('expiredCount').textContent = data.stats.expiredCount;
                    
                    document.getElementById('yearsCount').textContent = data.stats.yearsRemaining;
                    document.getElementById('monthsCount').textContent = data.stats.monthsRemaining;
                    document.getElementById('daysCount').textContent = data.stats.daysRemaining;
                }
            }
        } catch (e) { console.error('Error loading stats:', e); }
    }

    async function loadRetentionDocuments() {
        try {
            const [yearsRes, monthsRes, daysRes] = await Promise.all([
                fetch('/api/RetentionApi/documents?category=years'),
                fetch('/api/RetentionApi/documents?category=months'),
                fetch('/api/RetentionApi/documents?category=days')
            ]);

            if (yearsRes.ok) {
                const data = await yearsRes.json();
                yearsData = data.retentions || [];
                renderYearsTable();
            }
            if (monthsRes.ok) {
                const data = await monthsRes.json();
                monthsData = data.retentions || [];
                renderMonthsTable();
            }
            if (daysRes.ok) {
                const data = await daysRes.json();
                daysData = data.retentions || [];
                renderDaysTable();
            }
        } catch (e) { console.error('Error loading retention documents:', e); }
    }

    async function loadPolicies() {
        try {
            const response = await fetch('/api/RetentionApi/policies');
            if (response.ok) {
                const data = await response.json();
                policiesData = data.policies || [];
                renderPoliciesTable();
            }
        } catch (e) { console.error('Error loading policies:', e); }
    }

    function renderYearsTable() {
        const tbody = document.getElementById('yearsTableBody');
        if (yearsData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No documents with more than 1 year remaining</td></tr>';
            return;
        }
        tbody.innerHTML = yearsData.map(r => `
            <tr>
                <td>
                    <i class="bi ${getFileIcon(r.fileExtension)} me-2"></i>
                    <strong>${escapeHtml(r.documentTitle)}</strong>
                    <br><small class="text-muted">${escapeHtml(r.originalFileName || '')}</small>
                </td>
                <td><span class="badge bg-secondary">${escapeHtml(r.documentType || 'Unknown')}</span></td>
                <td>${escapeHtml(r.clientName || '-')}</td>
                <td>${formatDate(r.retentionStartDate)}</td>
                <td>${formatDate(r.expiryDate)}</td>
                <td>
                    <span class="text-success fw-bold">${Math.floor(r.daysRemaining / 365)} years</span>
                    <br><small class="text-muted">${r.daysRemaining} days</small>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="viewDocument(${r.documentId})">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="showModifyModal(${r.documentId}, '${escapeHtml(r.documentTitle)}', ${r.retentionYears || 0}, ${r.retentionMonths || 0}, ${r.retentionDays || 0})">
                        <i class="bi bi-pencil"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    }

    function renderMonthsTable() {
        const tbody = document.getElementById('monthsTableBody');
        if (monthsData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No documents with 1-12 months remaining</td></tr>';
            return;
        }
        tbody.innerHTML = monthsData.map(r => `
            <tr>
                <td>
                    <i class="bi ${getFileIcon(r.fileExtension)} me-2"></i>
                    <strong>${escapeHtml(r.documentTitle)}</strong>
                </td>
                <td><span class="badge bg-secondary">${escapeHtml(r.documentType || 'Unknown')}</span></td>
                <td>${escapeHtml(r.clientName || '-')}</td>
                <td>${formatDate(r.retentionStartDate)}</td>
                <td>${formatDate(r.expiryDate)}</td>
                <td>
                    <span class="text-warning fw-bold">${Math.floor(r.daysRemaining / 30)} months</span>
                    <br><small class="text-muted">${r.daysRemaining} days</small>
                </td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="viewDocument(${r.documentId})">
                        <i class="bi bi-eye"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="showModifyModal(${r.documentId}, '${escapeHtml(r.documentTitle)}', ${r.retentionYears || 0}, ${r.retentionMonths || 0}, ${r.retentionDays || 0})">
                        <i class="bi bi-pencil"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    }

    function renderDaysTable() {
        const tbody = document.getElementById('daysTableBody');
        if (daysData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No documents with less than 365 days remaining</td></tr>';
            return;
        }
        tbody.innerHTML = daysData.map(r => {
            const urgencyClass = r.daysRemaining <= 30 ? 'text-danger' : r.daysRemaining <= 90 ? 'text-warning' : 'text-info';
            return `
                <tr class="${r.daysRemaining <= 0 ? 'table-danger' : ''}">
                    <td>
                        <i class="bi ${getFileIcon(r.fileExtension)} me-2"></i>
                        <strong>${escapeHtml(r.documentTitle)}</strong>
                    </td>
                    <td><span class="badge bg-secondary">${escapeHtml(r.documentType || 'Unknown')}</span></td>
                    <td>${escapeHtml(r.clientName || '-')}</td>
                    <td>${formatDate(r.retentionStartDate)}</td>
                    <td>${formatDate(r.expiryDate)}</td>
                    <td>
                        <span class="${urgencyClass} fw-bold">${r.daysRemaining <= 0 ? 'EXPIRED' : r.daysRemaining + ' days'}</span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="viewDocument(${r.documentId})">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="showModifyModal(${r.documentId}, '${escapeHtml(r.documentTitle)}', ${r.retentionYears || 0}, ${r.retentionMonths || 0}, ${r.retentionDays || 0})">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function renderPoliciesTable() {
        const tbody = document.getElementById('policiesTableBody');
        if (policiesData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">No policies created yet</td></tr>';
            return;
        }
        tbody.innerHTML = policiesData.map(p => `
            <tr>
                <td><strong>${escapeHtml(p.policyName)}</strong></td>
                <td>${escapeHtml(p.documentType || 'All Types')}</td>
                <td>${p.retentionYears} years, ${p.retentionMonths} months, ${p.retentionDays} days</td>
                <td><span class="badge bg-info">${p.documentCount}</span></td>
                <td>${p.isDefault ? '<span class="badge bg-success">Default</span>' : ''}</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="editPolicy(${p.policyId})">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deletePolicy(${p.policyId})">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    }

    function showModifyModal(docId, title, years, months, days) {
        document.getElementById('modifyDocId').value = docId;
        document.getElementById('modifyDocTitle').textContent = title;
        document.getElementById('modifyYears').value = years;
        document.getElementById('modifyMonths').value = months;
        document.getElementById('modifyDays').value = days;
        document.getElementById('modifyReason').value = '';
        new bootstrap.Modal(document.getElementById('modifyRetentionModal')).show();
    }

    async function saveModifiedRetention() {
        const docId = document.getElementById('modifyDocId').value;
        const data = {
            retentionYears: parseInt(document.getElementById('modifyYears').value) || 0,
            retentionMonths: parseInt(document.getElementById('modifyMonths').value) || 0,
            retentionDays: parseInt(document.getElementById('modifyDays').value) || 0,
            reason: document.getElementById('modifyReason').value
        };

        try {
            const response = await fetch(`/api/RetentionApi/document/${docId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                alert('Retention period modified successfully!');
                bootstrap.Modal.getInstance(document.getElementById('modifyRetentionModal')).hide();
                loadRetentionDocuments();
                loadStats();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) {
            alert('Error modifying retention');
        }
    }

    async function savePolicy() {
        const policyId = document.getElementById('policyId').value;
        const data = {
            policyName: document.getElementById('policyName').value,
            documentType: document.getElementById('policyDocType').value || null,
            retentionYears: parseInt(document.getElementById('policyYears').value) || 0,
            retentionMonths: parseInt(document.getElementById('policyMonths').value) || 0,
            retentionDays: parseInt(document.getElementById('policyDays').value) || 0,
            description: document.getElementById('policyDescription').value,
            isDefault: document.getElementById('policyIsDefault').checked
        };

        try {
            const url = policyId ? `/api/RetentionApi/policies/${policyId}` : '/api/RetentionApi/policies';
            const method = policyId ? 'PUT' : 'POST';
            
            const response = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                alert('Policy saved successfully!');
                bootstrap.Modal.getInstance(document.getElementById('createPolicyModal')).hide();
                loadPolicies();
                loadStats();
                resetPolicyForm();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) {
            alert('Error saving policy');
        }
    }

    async function editPolicy(policyId) {
        try {
            const response = await fetch(`/api/RetentionApi/policies/${policyId}`);
            const data = await response.json();
            if (data.success) {
                const p = data.policy;
                document.getElementById('policyId').value = p.policyId;
                document.getElementById('policyModalTitle').textContent = 'Edit Retention Policy';
                document.getElementById('policyName').value = p.policyName;
                document.getElementById('policyDocType').value = p.documentType || '';
                document.getElementById('policyYears').value = p.retentionYears || 0;
                document.getElementById('policyMonths').value = p.retentionMonths || 0;
                document.getElementById('policyDays').value = p.retentionDays || 0;
                document.getElementById('policyDescription').value = p.description || '';
                document.getElementById('policyIsDefault').checked = p.isDefault || false;
                new bootstrap.Modal(document.getElementById('createPolicyModal')).show();
            }
        } catch (e) {
            alert('Error loading policy');
        }
    }

    async function deletePolicy(policyId) {
        if (!confirm('Are you sure you want to delete this policy?')) return;
        
        try {
            const response = await fetch(`/api/RetentionApi/policies/${policyId}`, { method: 'DELETE' });
            const result = await response.json();
            if (result.success) {
                alert('Policy deleted!');
                loadPolicies();
                loadStats();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) {
            alert('Error deleting policy');
        }
    }

    async function processExpired() {
        if (!confirm('This will archive all expired documents. Continue?')) return;
        
        try {
            const response = await fetch('/api/RetentionApi/process-expired', { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                alert(`Processed ${result.archivedCount} expired documents!`);
                loadRetentionDocuments();
                loadStats();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) {
            alert('Error processing expired documents');
        }
    }

    function resetPolicyForm() {
        document.getElementById('policyId').value = '';
        document.getElementById('policyModalTitle').textContent = 'Create Retention Policy';
        document.getElementById('policyForm').reset();
        document.getElementById('policyYears').value = 7;
    }

    function viewDocument(docId) {
        window.location.href = `/Admin/Document?id=${docId}`;
    }

    function getFileIcon(ext) {
        const icons = {
            '.pdf': 'bi-file-pdf text-danger',
            '.doc': 'bi-file-word text-primary',
            '.docx': 'bi-file-word text-primary'
        };
        return icons[ext?.toLowerCase()] || 'bi-file-earmark text-secondary';
    }

    function formatDate(dateStr) {
        if (!dateStr) return '-';
        return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Reset form when modal closes
    document.getElementById('createPolicyModal').addEventListener('hidden.bs.modal', resetPolicyForm);

    // ===== Process Retention Now =====
    async function processRetentionNow() {
        const btn = document.getElementById('btnProcessNow');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';
        try {
            const response = await fetch('/api/RetentionApi/process-retention-now', { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                alert(`${result.message}`);
                loadDispositionQueue();
                loadStats();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) {
            alert('Error processing retention lifecycle');
            console.error(e);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-lightning-charge me-1"></i>Process Retention Now';
        }
    }

    // ===== Disposition Queue =====
    async function loadDispositionQueue() {
        try {
            const [queueRes, statsRes] = await Promise.all([
                fetch('/api/RetentionApi/disposition'),
                fetch('/api/RetentionApi/disposition-stats')
            ]);

            if (queueRes.ok) {
                const data = await queueRes.json();
                dispositionData = data.archives || [];
                renderDispositionTable();
            }

            if (statsRes.ok) {
                const data = await statsRes.json();
                if (data.success) {
                    document.getElementById('dispPending').textContent = data.stats.pendingReview;
                    document.getElementById('dispOnHold').textContent = data.stats.onHold;
                    document.getElementById('dispDestroyed').textContent = data.stats.destroyed;
                    document.getElementById('dispExpiring').textContent = data.stats.expiringGracePeriod;
                    document.getElementById('dispositionCount').textContent = data.stats.pendingReview + data.stats.onHold;
                }
            }
        } catch (e) { console.error('Error loading disposition queue:', e); }
    }

    function renderDispositionTable() {
        const tbody = document.getElementById('dispositionTableBody');
        if (dispositionData.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-check-circle me-2"></i>No documents in disposition queue</td></tr>';
            return;
        }

        tbody.innerHTML = dispositionData.map(a => {
            let statusBadge = '';
            let actions = '';
            
            if (a.dispositionStatus === 'Destroyed') {
                statusBadge = '<span class="badge bg-secondary"><i class="bi bi-trash me-1"></i>Destroyed</span>';
                actions = `
                    <button class="btn btn-sm btn-outline-dark" onclick="downloadCertificate(${a.archiveId})" title="Download Destruction Certificate">
                        <i class="bi bi-file-earmark-lock"></i>
                    </button>`;
            } else if (a.isOnHold) {
                statusBadge = `<span class="badge bg-danger"><i class="bi bi-shield-lock me-1"></i>On Hold</span>
                    <br><small class="text-muted mt-1 d-block">${escapeHtml(a.holdReason || '')}</small>`;
                actions = `
                    <button class="btn btn-sm btn-outline-success" onclick="releaseHold(${a.archiveId})" title="Release Hold">
                        <i class="bi bi-shield-slash"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-info" onclick="retrieveFromDisposition(${a.archiveId}, '${escapeHtml(a.documentTitle)}')" title="Retrieve Document">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>`;
            } else {
                const urgency = a.daysUntilDeletion <= 7 ? 'bg-danger' : a.daysUntilDeletion <= 14 ? 'bg-warning text-dark' : 'bg-info text-dark';
                statusBadge = `<span class="badge ${urgency}"><i class="bi bi-hourglass-split me-1"></i>${a.daysUntilDeletion}d grace remaining</span>`;
                actions = `
                    <button class="btn btn-sm btn-outline-info" onclick="retrieveFromDisposition(${a.archiveId}, '${escapeHtml(a.documentTitle)}')" title="Retrieve Document">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-warning" onclick="showHoldModal(${a.archiveId}, '${escapeHtml(a.documentTitle)}')" title="Place Legal Hold">
                        <i class="bi bi-shield-lock"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="approveDeletion(${a.archiveId}, '${escapeHtml(a.documentTitle)}')" title="Approve Immediate Deletion">
                        <i class="bi bi-trash"></i>
                    </button>`;
            }

            return `
                <tr class="${a.dispositionStatus === 'Destroyed' ? 'table-light text-muted' : a.isOnHold ? 'table-warning' : ''}">
                    <td>
                        <strong>${escapeHtml(a.documentTitle)}</strong>
                        <br><small class="text-muted">${escapeHtml(a.documentType || 'Unknown')}</small>
                    </td>
                    <td>${escapeHtml(a.clientName || '-')}</td>
                    <td>${formatDate(a.retentionExpiredDate)}</td>
                    <td>${a.dispositionStatus === 'Destroyed' ? '<span class="text-muted">N/A</span>' : formatDate(a.gracePeriodEndDate)}</td>
                    <td>${statusBadge}</td>
                    <td>${actions}</td>
                </tr>`;
        }).join('');
    }

    function showHoldModal(archiveId, title) {
        currentHoldArchiveId = archiveId;
        document.getElementById('holdDocTitle').textContent = title;
        document.getElementById('holdReason').value = '';
        new bootstrap.Modal(document.getElementById('holdModal')).show();
    }

    async function confirmPlaceHold() {
        const reason = document.getElementById('holdReason').value.trim();
        if (!reason) { alert('Please enter a reason for the legal hold.'); return; }

        try {
            const response = await fetch(`/api/RetentionApi/hold/${currentHoldArchiveId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            });
            const result = await response.json();
            if (result.success) {
                alert('Legal hold placed successfully!');
                bootstrap.Modal.getInstance(document.getElementById('holdModal')).hide();
                loadDispositionQueue();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) { alert('Error placing legal hold'); }
    }

    async function releaseHold(archiveId) {
        if (!confirm('Release the legal hold? A new 30-day grace period will start.')) return;

        try {
            const response = await fetch(`/api/RetentionApi/release-hold/${archiveId}`, { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                alert(result.message);
                loadDispositionQueue();
            } else {
                alert('Error: ' + result.message);
            }
        } catch (e) { alert('Error releasing hold'); }
    }

    async function approveDeletion(archiveId, title) {
        if (!confirm(`PERMANENTLY DELETE "${title}"?\n\nThis will delete all physical files. Metadata will be preserved for audit purposes. A destruction certificate will be generated.\n\nThis action CANNOT be undone.`)) return;

        try {
            const response = await fetch(`/api/RetentionApi/approve-deletion/${archiveId}`, { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                alert('Document permanently destroyed successfully!');
                loadDispositionQueue();
                loadStats();
                // Auto-download the destruction certificate
                setTimeout(() => downloadCertificate(archiveId), 500);
            } else {
                alert('Error: ' + (result.message || 'Unknown error'));
            }
        } catch (e) {
            console.error('Error approving deletion:', e);
            alert('Error approving deletion. Please check the console for details.');
        }
    }

    async function retrieveFromDisposition(archiveId, title) {
        if (!confirm(`Retrieve "${title}" from disposition queue?\n\nThis will restore the document to its original status and reset its retention period.`)) return;

        try {
            const response = await fetch(`/api/RetentionApi/retrieve/${archiveId}`, { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                alert(result.message || 'Document retrieved successfully!');
                loadDispositionQueue();
                loadStats();
                loadRetentionDocuments();
            } else {
                alert('Error: ' + (result.message || 'Unknown error'));
            }
        } catch (e) {
            console.error('Error retrieving document:', e);
            alert('Error retrieving document from disposition queue.');
        }
    }

    async function downloadCertificate(archiveId) {
        try {
            const response = await fetch(`/api/RetentionApi/destruction-certificate/${archiveId}`);
            const data = await response.json();
            if (!data.success) { alert(data.message || 'Error loading certificate'); return; }

            const cert = data.certificate;
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            // Header
            doc.setFontSize(20);
            doc.setFont('helvetica', 'bold');
            doc.text('CERTIFICATE OF DESTRUCTION', 105, 25, { align: 'center' });
            
            doc.setFontSize(10);
            doc.setFont('helvetica', 'normal');
            doc.text(`Certificate No: ${cert.certificateNumber}`, 105, 33, { align: 'center' });
            
            doc.setDrawColor(0, 100, 200);
            doc.setLineWidth(0.5);
            doc.line(20, 38, 190, 38);

            // Firm info
            doc.setFontSize(12);
            doc.setFont('helvetica', 'bold');
            doc.text(cert.firmName, 20, 48);

            // Document details
            let y = 58;
            const addRow = (label, value) => {
                doc.setFont('helvetica', 'bold');
                doc.setFontSize(10);
                doc.text(label + ':', 20, y);
                doc.setFont('helvetica', 'normal');
                doc.text(String(value || 'N/A'), 75, y);
                y += 7;
            };

            addRow('Document Title', cert.documentTitle);
            addRow('Document ID', cert.documentId);
            addRow('Document Type', cert.documentType);
            addRow('Client Name', cert.clientName);
            addRow('Original Upload', cert.originalUploadDate ? new Date(cert.originalUploadDate).toLocaleDateString() : 'N/A');
            addRow('Approved Date', cert.approvedDate ? new Date(cert.approvedDate).toLocaleDateString() : 'N/A');
            addRow('Retention Expiry', cert.retentionExpiryDate ? new Date(cert.retentionExpiryDate).toLocaleDateString() : 'N/A');
            addRow('Grace Period End', cert.gracePeriodEndDate ? new Date(cert.gracePeriodEndDate).toLocaleDateString() : 'N/A');
            addRow('Destroyed Date', cert.destroyedDate ? new Date(cert.destroyedDate).toLocaleDateString() : 'N/A');
            addRow('Destroyed By', cert.destroyedBy);
            addRow('Destruction Method', cert.destructionMethod);
            
            if (cert.wasOnHold) {
                addRow('Was On Legal Hold', 'Yes');
                addRow('Hold Reason', cert.holdReason || 'N/A');
            }

            // Certification statement
            y += 10;
            doc.setDrawColor(0, 100, 200);
            doc.line(20, y, 190, y);
            y += 10;

            doc.setFont('helvetica', 'bold');
            doc.setFontSize(11);
            doc.text('CERTIFICATION STATEMENT', 20, y);
            y += 8;

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(9);
            const lines = doc.splitTextToSize(cert.certificationStatement, 170);
            doc.text(lines, 20, y);
            y += lines.length * 5 + 15;

            // Signature line
            doc.line(20, y, 80, y);
            y += 5;
            doc.setFontSize(8);
            doc.text('Authorized Signature', 20, y);
            y += 5;
            doc.text(`Date: ${new Date().toLocaleDateString()}`, 20, y);

            // Footer
            doc.setFontSize(7);
            doc.setTextColor(128);
            doc.text('This certificate was electronically generated and is valid without signature.', 105, 285, { align: 'center' });

            doc.save(`Destruction_Certificate_${cert.certificateNumber}.pdf`);
        } catch (e) {
            console.error('Error generating certificate:', e);
            alert('Error generating destruction certificate');
        }
    }
</script>
}
