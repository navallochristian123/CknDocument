# Copy this file to .env (or .env.development) and fill real values.
ConnectionStrings__DefaultConnection=
Jwt__Key=
Jwt__Issuer=CKNDocument
Jwt__Audience=CKNDocumentUsers
Jwt__ExpiryMinutes=60
PayMongo__SecretKey=
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini
OpenAI__MaxTokens=4000

# Optional backup SuperAdmin seed account (used if missing)
BACKUP_SUPERADMIN_USERNAME=backup_superadmin
BACKUP_SUPERADMIN_EMAIL=backup.superadmin@ckn.com
BACKUP_SUPERADMIN_PASSWORD=BackupSuperAdmin@123
GoogleReCaptcha__SiteKey=
GoogleReCaptcha__SecretKey=
EmailSmtp__Host=smtp.gmail.com
EmailSmtp__Port=587
EmailSmtp__EnableSsl=true
EmailSmtp__Username=
EmailSmtp__Password=
EmailSmtp__FromName=CKNDocument
